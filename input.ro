// Wasm test
__builtin fn print(content: str);
__builtin fn printi(content: int);

fn print_two_strings(a: str, b: str) {
	let c = a + b;

	print(c);
}

fn print_two_things(a: int, b: int) {
	let c = a + b;

	printi(c);
}

fn main() {
	print_two_things(3, 4);
	print_two_strings("abc", "def");
}